{
  "name": "docsync",
  "version": "0.1.0",
  "description": "Keeps your documentation in sync with your code — LLM-powered doc updates on every PR",
  "type": "module",
  "bin": {
    "docsync": "./dist/cli.js",
    "autodocs": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "keywords": ["documentation", "docs", "llm", "ai", "github-actions", "typescript", "python"],
  "author": "Alok650",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alok650/docsync.git"
  },
  "homepage": "https://github.com/Alok650/docsync#readme",
  "bugs": {
    "url": "https://github.com/Alok650/docsync/issues"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@octokit/rest": "^22.0.1",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "openai": "^6.35.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "unified": "^11.0.5",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
